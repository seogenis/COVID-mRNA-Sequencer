{
  "name": "atlas",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "description": "Atlas — a spatial strategy & task map for undefined problem spaces. Built for Synphony.",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "build:single": "ATLAS_TARGET=artifact vite build --outDir dist-single --emptyOutDir && cp dist-single/index.html atlas-standalone.html",
    "preview": "vite preview",
    "test:e2e": "npm run build:single && node e2e/smoke.mjs"
  },
  "dependencies": {
    "@react-three/drei": "^9.114.0",
    "@react-three/fiber": "^8.17.10",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "three": "^0.169.0",
    "zustand": "^4.5.5"
  },
  "devDependencies": {
    "playwright": "^1.48.0",
    "@types/node": "^26.1.1",
    "@types/react": "^18.3.11",
    "@types/react-dom": "^18.3.0",
    "@types/three": "^0.169.0",
    "@vitejs/plugin-react": "^4.3.2",
    "typescript": "^5.6.2",
    "vite": "^5.4.8",
    "vite-plugin-singlefile": "^2.3.3"
  }
}
