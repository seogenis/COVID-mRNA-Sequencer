<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/capturePanel"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical">

    <!--
        The preview is only a framing aid. It is deliberately small so the prompt and
        status text stay readable on the monochrome HUD.
    -->
    <androidx.camera.view.PreviewView
        android:id="@+id/cameraPreviewView"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1" />

    <TextView
        android:id="@+id/capturePromptView"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="10dp"
        android:fontFamily="monospace"
        android:gravity="center"
        android:maxLines="2"
        android:textColor="@color/hud_foreground"
        android:textSize="16dp"
        android:textStyle="bold" />

    <TextView
        android:id="@+id/captureStatusView"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="4dp"
        android:fontFamily="monospace"
        android:gravity="center"
        android:maxLines="2"
        android:textColor="@color/hud_foreground_muted"
        android:textSize="11dp" />
</LinearLayout>
